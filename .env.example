# Postgres connection for server routes. On Supabase use the pooler connection string
# (Project Settings → Database), which connects as a privileged role.
DATABASE_URL=postgres://postgres@localhost:54322/postgres
# Limit the widget to one company's sites.
COMPANY_SLUG=joses
# Space-separated origins allowed to embed /book in an iframe.
EMBED_ORIGINS=
# Interim staff access to /diary until Supabase Auth is wired up.
STAFF_PASSWORD=
# 32+ random characters, e.g. `openssl rand -base64 32`.
STAFF_SESSION_SECRET=
# Public base URL, used in email links (unsubscribe, booking, open pixel).
APP_URL=http://localhost:3000
# Email delivery via Resend; without these, marketing sends are logged, not delivered.
RESEND_API_KEY=
EMAIL_FROM="Jose's <hello@example.com>"
# Shared secret for the hourly call to /api/cron/hourly (reminders and automations).
CRON_SECRET=
